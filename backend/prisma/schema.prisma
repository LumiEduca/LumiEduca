generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  PROFESSOR
  ALUNO
}

model Usuario {
  id            String       @id @default(uuid())
  nome          String
  usuario       String       @unique
  senhaHash     String
  tipo          TipoUsuario
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  salasCriadas  Sala[]           @relation("SalasDoProfessor")
  matriculas    Matricula[]
  atividadesCriadas Atividade[]  @relation("AtividadesDoProfessor")
  progresso     Progresso[]
  tokens        NotificacaoToken[]
  notificacoes  Notificacao[]
  respostas     Resposta[]
  conquistas    UsuarioConquista[]
  dicasLumi     LumiDica[]
  lembretes     LembreteAtividade[]

  @@map("usuarios")
}

model Sala {
  id          String   @id @default(uuid())
  nome        String
  codigo      String   @unique
  professorId String
  professor   Usuario  @relation("SalasDoProfessor", fields: [professorId], references: [id])
  criadaEm    DateTime @default(now())

  matriculas     Matricula[]
  salaAtividades SalaAtividade[]

  @@map("salas")
}

model Matricula {
  id       String   @id @default(uuid())
  alunoId  String
  aluno    Usuario  @relation(fields: [alunoId], references: [id])
  salaId   String
  sala     Sala     @relation(fields: [salaId], references: [id])
  entrouEm DateTime @default(now())

  @@unique([alunoId, salaId])
  @@map("matriculas")
}

model Atividade {
  id          String    @id @default(uuid())
  titulo      String
  materia     String
  professorId String
  professor   Usuario   @relation("AtividadesDoProfessor", fields: [professorId], references: [id])
  prazo       DateTime?
  criadaEm    DateTime  @default(now())

  questoes       Questao[]
  progresso      Progresso[]
  salaAtividades SalaAtividade[]
  lembretes      LembreteAtividade[]

  @@map("atividades")
}

model Questao {
  id              String     @id @default(uuid())
  atividadeId     String
  atividade       Atividade  @relation(fields: [atividadeId], references: [id])
  enunciado       String
  opcoes          Json
  respostaCorreta String
  tipo            String     @default("MULTIPLA_ESCOLHA")
  ordem           Int        @default(0)
  respostas       Resposta[]
  dicasLumi       LumiDica[]

  @@map("questoes")
}

model Progresso {
  id           String     @id @default(uuid())
  alunoId      String
  aluno        Usuario    @relation(fields: [alunoId], references: [id])
  atividadeId  String?
  atividade    Atividade? @relation(fields: [atividadeId], references: [id])
  materia      String?
  pontos       Int        @default(0)
  concluida    Boolean    @default(false)
  atualizadoEm DateTime   @updatedAt

  @@unique([alunoId, atividadeId])
  @@map("progresso")
}

model NotificacaoToken {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  token     String   @unique
  criadoEm  DateTime @default(now())

  @@map("notificacao_tokens")
}

model Notificacao {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo    String
  corpo     String
  lida      Boolean  @default(false)
  criadaEm  DateTime @default(now())

  @@index([usuarioId, criadaEm])
  @@map("notificacoes")
}

model SalaAtividade {
  id          String    @id @default(uuid())
  salaId      String
  sala        Sala      @relation(fields: [salaId], references: [id], onDelete: Cascade)
  atividadeId String
  atividade   Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  criadaEm    DateTime  @default(now())

  @@unique([salaId, atividadeId])
  @@map("sala_atividades")
}

model Resposta {
  id           String   @id @default(uuid())
  alunoId      String
  aluno        Usuario  @relation(fields: [alunoId], references: [id])
  questaoId    String
  questao      Questao  @relation(fields: [questaoId], references: [id])
  resposta     String
  correta      Boolean
  respondidaEm DateTime @default(now())

  @@unique([alunoId, questaoId])
  @@map("respostas")
}

model AvaliacaoDemo {
  id       String   @id @default(uuid())
  jogo     String
  nota     Int
  criadaEm DateTime @default(now())

  @@index([jogo, criadaEm])
  @@map("avaliacoes_demo")
}

model Conquista {
  id          String             @id @default(uuid())
  codigo      String             @unique
  nome        String
  descricao   String

  usuarios    UsuarioConquista[]

  @@map("conquistas")
}

model UsuarioConquista {
  id          String    @id @default(uuid())
  alunoId     String
  aluno       Usuario   @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  conquistaId String
  conquista   Conquista @relation(fields: [conquistaId], references: [id], onDelete: Cascade)
  concedidaEm DateTime  @default(now())

  @@unique([alunoId, conquistaId])
  @@index([alunoId])
  @@map("usuario_conquistas")
}

model LumiDica {
  id         String   @id @default(uuid())
  alunoId    String
  aluno      Usuario  @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  questaoId  String?
  questao    Questao? @relation(fields: [questaoId], references: [id], onDelete: SetNull)
  pergunta   String
  resposta   String
  criadaEm   DateTime @default(now())

  @@index([alunoId, criadaEm])
  @@map("lumi_dicas")
}

model LembreteAtividade {
  id          String    @id @default(uuid())
  alunoId     String
  aluno       Usuario   @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  atividadeId String
  atividade   Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  enviadoEm   DateTime  @default(now())

  @@unique([alunoId, atividadeId])
  @@map("lembretes_atividade")
}
