# Banco (Neon)
# DATABASE_URL = connection string COM pooler (-pooler no host), usada pela aplicação
# DIRECT_URL   = connection string SEM pooler, usada pelas migrations (prisma migrate)
DATABASE_URL=""
DIRECT_URL=""

# Autenticação
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Servidor
PORT=5000

# Frontend (CORS)
# URL do frontend autorizado a acessar a API
FRONTEND_URL=""

# IA do Lumi (Gemini) - fica SOMENTE no backend
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# Notificações (Firebase) - opcional
# Credencial da conta de serviço codificada em Base64
FIREBASE_SERVICE_ACCOUNT_BASE64=""

# Senha para os usuários gerados no comando de seed
SEED_PASSWORD="senha_local_123"

REACT_APP_API_URL=
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_VAPID_KEY=